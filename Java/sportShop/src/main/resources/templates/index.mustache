<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>Products</title>
</head>
<body>
<h1>
    All products
</h1>

<form method="get" class="form-inline">
    <div class="form-floating mb-2">
        <input name="title" class="form-control"/>
        <label>Name</label>
    </div>
    <div class="form-floating mb-2">
        <input name="brand" class="form-control"/>
        <label>Brand</label>
    </div>
    <div class="form-floating mb-2">
        <input name="price" type="number" class="form-control"/>
        <label>Price</label>
    </div>
    <div class="form-floating mb-2">
        <input name="size" class="form-control"/>
        <label>Size</label>
    </div>
    <div class="form-floating mb-2">
        <input name="color" class="form-control"/>
        <label>Color</label>
    </div>
    <div class="form-floating mb-2">
        <input name="category" class="form-control"/>
        <label>Category</label>
    </div>

    <input type="submit" value="Search" class="btn w-100 btn-outline-dark"/>
</form>


<table class="table table-sm table-hover table-bordered table-striped">
    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Brand</th>
        <th>Price</th>
        <th>Size</th>
        <th>Color</th>
        <th>Category</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    {{#items}}
        <tr>
            <td>
                {{id}}
            </td>
            <td>
                <a class="link link-body-emphasis link-underline-dark link-underline-opacity-50 link-underline-opacity-100-hover"
                   href="/products/{{id}}">
                    {{name}}
                </a>
            </td>
            <td>{{brand}}</td>
            <td>{{price}}</td>
            <td>{{size}}</td>
            <td>{{color}}</td>
            <td>{{category}}</td>
            <td>
                <a id="delete-btn" class="btn btn-sm btn-danger" onclick="deleteItem({{id}})">
                    Delete
                </a>
            </td>
        </tr>
    {{/items}}
    </tbody>
</table>

<form method="post" class="form-inline mt-5">
    <h2>Create product</h2>
    <div class="form-floating mb-2">
        <input name="name" class="form-control" required/>
        <label>Name</label>
    </div>
    <div class="form-floating mb-2">
        <input name="brand" class="form-control" required/>
        <label>Brand</label>
    </div>
    <div class="form-floating mb-2">
        <input name="price" type="number" class="form-control" required/>
        <label>Price</label>
    </div>
    <div class="form-floating mb-2">
        <input name="size" class="form-control" required/>
        <label>Size</label>
    </div>
    <div class="form-floating mb-2">
        <input name="color" class="form-control" required/>
        <label>Color</label>
    </div>
    <div class="form-floating mb-2">
        <input name="category" class="form-control" required/>
        <label>Category</label>
    </div>

    <input type="submit" value="Create" class="btn w-100 btn-outline-dark"/>
</form>

<script type="text/javascript">
    async function deleteItem(id) {
        try  {
            let confirmedDelete = confirm("Are you sure that you want to delete this product?")
            if (!confirmedDelete) return
            await fetch(`/products/` + id, {
                method: "DELETE",
                headers: { "Accept": "application/json", "Content-Type": "application/json" }
            });
            alert("Delete success!")
            window.location.href = '/products';
        } catch (error) {
            console.log(error);
            alert('Something went wrong!');
        }
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>